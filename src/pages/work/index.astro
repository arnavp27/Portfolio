---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Work — Arnav Patil" description="Projects and engineering work by Arnav Patil.">
  <main class="detail-page content-width" id="main">
    <div id="top"></div>
    <a class="back-link" href="/">
      ← Back to the garage
    </a>
    <header class="detail-header">
      <p class="eyebrow">Things I’ve built</p>
      <h1>Work</h1>
    </header>
    {projects.map((project) => (
      <a class="article-link" href={`/work/${project.id}/`}>
        <span>{project.data.title}</span>
        <small>{project.data.category} ↗</small>
      </a>
    ))}
  </main>
</Layout>

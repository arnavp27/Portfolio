# HTML and stable /assets/ URLs retain Cloudflare's ETag revalidation defaults.
# Only content-hashed build output can safely remain immutable across updates.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The sky loader decompresses this gzip file itself; keep its stored bytes intact.
/assets/garage/surfaces/night-sky.rgba16f.bin
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  ! Content-Encoding

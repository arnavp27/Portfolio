{
  "name": "arnav-garage",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/astro.mjs check build",
    "preview": "node scripts/serve.mjs dist",
    "check": "node scripts/astro.mjs check",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run build",
    "check:deploy": "node scripts/check-deployment.mjs",
    "deploy": "npm run check:deploy && wrangler pages deploy dist --project-name arnavpatil --branch main",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "4.154.0"
  }
}
